# Copy this file to .env and fill in your values.

# PostgreSQL connection string (Supabase Session Pooler, IPv4-compatible)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/teashore

# JWT authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Rotate this secret if it is ever exposed. Rotating it invalidates
# all existing tokens — all users will be logged out.
# This secret does NOT expire on its own, but if the app is redeployed with a
# new secret all existing tokens become invalid immediately.
JWT_SECRET_KEY=change-me-generate-a-real-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 10080 minutes = 7 days.  Adjust downward for stricter security.

# CORS — allowed frontend origins (production only)
# Comma-separated list of origins that browsers are permitted to call this API from.
# Dev origins (localhost:5173 / 5174) are always included automatically.
#
# Rules:
#   - No trailing slash on any URL.
#   - Include every distinct Vercel URL that will make requests:
#       • The stable production domain (e.g. https://teashore.vercel.app)
#       • The stable custom domain if one is configured (e.g. https://www.teashore.in)
#       • Any Vercel preview deployment URLs you actively use in testing.
#         Preview URLs look like: https://tea-shore-site-<hash>-<user>-projects.vercel.app
#         Add them individually — wildcards are not supported by this implementation.
#   - The value set here must match VITE_API_BASE_URL's origin exactly.
#
# Example:
# FRONTEND_ORIGINS=https://teashore.vercel.app,https://tea-shore-site-g09wtl8yx-prasadbbraos-projects.vercel.app
#
# Leave blank (or omit) for local development only.
FRONTEND_ORIGINS=
